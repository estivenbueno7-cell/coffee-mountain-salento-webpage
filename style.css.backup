o-note small{font-size:8px;letter-spacing:2px;color:rgba(255,255,255,.65)}.featured-thumbs{position:absolute;left:25px;bottom:25px;display:flex;gap:7px}.featured-thumb{width:52px;height:42px;padding:0;border:2px solid transparent;background:none;border-radius:7px;overflow:hidden;opacity:.65}.featured-thumb.active{border-color:#fff;opacity:1}.featured-thumb img{width:100%;height:100%;object-fit:cover}.feature-info{padding:62px 52px;display:flex;flex-direction:column;justify-content:center}.feature-badge{display:inline-flex;width:max-content;background:rgba(217,236,159,.13);border:1px solid rgba(217,236,159,.3);color:var(--accent);border-radius:999px;padding:8px 11px;font-size:8px;letter-spacing:1.6px;font-weight:800}.feature-meta{display:flex;gap:14px;flex-wrap:wrap;margin:28px 0 17px;color:rgba(255,255,255,.58);font-size:10px}.feature-info h3{font-size:clamp(36px,4vw,53px);margin-bottom:22px}.feature-info>p{color:rgba(255,255,255,.67);font-size:14px;line-height:1.8}.feature-checks{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:25px 0;color:#e5eddc;font-size:11px}.feature-bottom{margin-top:auto;padding-top:25px;border-top:1px solid rgba(255,255,255,.12);display:flex;justify-content:space-between;align-items:end;gap:20px}.feature-bottom small{display:block;font-size:8px;letter-spacing:1.5px;color:rgba(255,255,255,.4)}.feature-bottom strong{font-size:13px}.tour-section{background:#f9f7f1}.filter-wrap{display:flex;justify-content:center;margin-bottom:42px}.filters{display:flex;gap:7px;flex-wrap:wrap;justify-content:center;background:#ece8de;border-radius:999px;padding:5px}.filter{border:0;background:transparent;border-radius:999px;padding:9px 15px;font-size:10px;color:#66706a}.filter.active{background:var(--green);color:#fff;box-shadow:0 6px 15px rgba(18,53,38,.18)}.tour-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.tour-card{background:#fff;border:1px solid var(--line);border-radius:22px;overflow:hidden;transition:transform .3s,box-shadow .3s,border-color .3s;opacity:0;transform:translateY(18px)}.tour-card.visible{opacity:1;transform:none}.tour-card:hover{transform:translateY(-6px);box-shadow:0 22px 55px rgba(18,53,38,.12);border-color:transparent}.tour-card--featured{border:2px solid rgba(18,53,38,.18)}.tour-card-media{height:260px;width:100%;border:0;padding:0;position:relative;overflow:hidden;background:#173b2a;display:block}.tour-card-media img{width:100%;height:100%;object-fit:cover;transition:transform .5s}.tour-card:hover .tour-card-media img{transform:scale(1.06)}.tour-card-media:after{content:"";position:absolute;inset:0;background:linear-gradient(0deg,rgba(7,22,15,.58),transparent 52%)}.tour-card-badge{position:absolute;z-index:2;left:14px;top:14px;background:rgba(255,255,255,.93);border-radius:999px;padding:7px 9px;font-size:8px;font-weight:800;letter-spacing:.7px;color:var(--green)}.tour-card-arrow{position:absolute;z-index:2;right:14px;bottom:14px;width:35px;height:35px;border-radius:50%;background:rgba(255,255,255,.9);color:var(--green);display:grid;place-items:center;font-weight:800}.tour-card-content{padding:22px}.tour-card-meta{display:flex;justify-content:space-between;color:#8a928d;text-transform:uppercase;letter-spacing:1px;font-size:8px;margin-bottom:11px}.tour-card h3{font-size:23px;letter-spacing:-.035em;margin-bottom:10px}.tour-card p{font-size:12px;line-height:1.7;color:var(--muted);min-height:62px}.tour-card-bottom{border-top:1px solid var(--line);margin-top:17px;padding-top:16px;display:flex;justify-content:space-between;align-items:end;gap:10px}.tour-card-bottom small{display:block;font-size:7px;letter-spacing:1.5px;color:#909893}.tour-card-bottom strong{font-size:13px}.tour-detail{border:0;background:none;color:var(--green);font-size:10px;font-weight:800;padding:0}.tour-detail span{font-size:14px}.gallery-section{background:#fff}.masonry{display:grid;grid-template-columns:repeat(12,1fr);grid-auto-rows:75px;gap:12px}.gallery-item{border:0;padding:0;position:relative;border