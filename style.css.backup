nd:var(--accent);color:var(--green);box-shadow:0 14px 35px rgba(0,0,0,.14)}.btn-dark{background:var(--green);color:#fff}.btn-ghost{border:1px solid rgba(255,255,255,.28);color:#fff;background:rgba(255,255,255,.08);backdrop-filter:blur(10px)}.btn-large{padding:18px 27px;font-size:13px}.hero-trust{display:flex;gap:22px;margin-top:38px;font-size:10px;letter-spacing:1px;text-transform:uppercase;color:rgba(255,255,255,.62)}.hero-card{align-self:end;margin-bottom:105px;background:rgba(255,255,255,.95);color:var(--ink);border-radius:25px;overflow:hidden;box-shadow:0 25px 80px rgba(0,0,0,.28);transform:rotate(1deg);max-width:390px;justify-self:end}.hero-card-top{height:39px;padding:0 16px;display:flex;align-items:center;gap:8px;font-size:9px;font-weight:800;letter-spacing:1.6px;color:#59645e}.status-dot{width:7px;height:7px;background:#77b46b;border-radius:50%;box-shadow:0 0 0 4px rgba(119,180,107,.12)}.hero-card-star{margin-left:auto;color:#a27637}.hero-card-image{height:190px;overflow:hidden}.hero-card-image img{width:100%;height:100%;object-fit:cover}.hero-card-body{padding:22px}.mini-label,.eyebrow{font-size:9px;letter-spacing:2.2px;text-transform:uppercase;font-weight:800;color:#7a6250}.hero-card h2{font-size:25px;margin:8px 0 16px}.hero-card-tags{display:flex;gap:7px;flex-wrap:wrap;margin-bottom:18px}.hero-card-tags span{font-size:10px;background:#f1eee6;border-radius:999px;padding:7px 9px}.card-cta{width:100%;border:0;border-radius:13px;background:var(--green);color:#fff;padding:13px 15px;text-align:left;font-weight:800;font-size:11px;display:flex;justify-content:space-between}.hero-bottom{position:absolute;bottom:25px;left:0;width:100%;z-index:3}.hero-bottom-inner{display:flex;align-items:center;gap:15px;color:rgba(255,255,255,.55);font-size:8px;letter-spacing:2px}.scroll-line{width:65px;height:1px;background:rgba(255,255,255,.4)}.hero-bottom-inner span:last-child{margin-left:auto}.section{padding:115px 0}.intro{background:var(--cream)}.intro-layout{display:grid;gri