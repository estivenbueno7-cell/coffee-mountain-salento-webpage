-empty strong{font-family:'Playfair Display';font-size:26px;margin-top:18px}.video-empty p{font-size:11px;color:rgba(255,255,255,.5);max-width:330px}.video-empty code{color:var(--accent)}.video-card{margin:0}.video-card video{width:100%;height:320px;object-fit:cover;border-radius:20px;background:#08160f}.video-card h3{font-size:15px;margin:10px 4px}.why{background:var(--cream)}.why-grid{display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid var(--line);border-bottom:1px solid var(--line)}.value-card{min-height:300px;padding:28px 25px;border-right:1px solid var(--line);opacity:0;transform:translateY(18px)}.value-card.visible{opacity:1;transform:none}.value-card:last-child{border-right:0}.value-card>span{font-size:9px;letter-spacing:2px;color:var(--coffee)}.value-icon{font-size:30px;color:var(--green);margin:45px 0 17px}.value-card h3{font-size:23px;margin-bottom:10px}.value-card p{font-size:12px;color:var(--muted);line-height:1.7}.about{background:#fff}.about-panel{display:grid;grid-template-columns:1fr 1fr;gap:85px;align-items:center}.about-image{height:620px;border-radius:30px;overflow:hidden}.about-image img{width:100%;height:100%;object-fit:cover}.about-copy h2{font-size:clamp(45px,5vw,67px);margin:13px 0 22px}.about-copy p{font-size:14px;color:var(--muted);line-height:1.8;max-width:520px}.faq{background:#f9f7f1}.faq-layout{display:grid;grid-template-columns:.75fr 1.25fr;gap:100px}.faq-layout h2{font-size:clamp(44px,5vw,65px);margin:12px 0 18px}.faq-layout>div:first-child>p{font-size:13px;color:var(--muted);max-width:350px;margin-bottom:24px}.accordion details{border-top:1px solid var(--line);padding:22px 0}.accordion details:last-child{border-bottom:1px solid var(--line)}.accordion summary{list-style:none;cursor:pointer;display:flex;justify-content:space-between;gap:20px;font-weight:800;font-size:14px}.accordion summary::-webkit-details-marker{display:none}.accordion summary:after{content:'+';font-size:20px;font-weight:400;color:var(--coffee)}.accordion details[open] summary:after{content:'−'}.accordion p{font-size:12px;color:var(--muted);max-width:680px;margin:13px 0 0}.final-cta{height:650px;min-height:650px;padding:0!important;position:relative;color:#fff;overflow:hidden;display:flex;align-items:center}.final-cta-photo,.final-cta-shade{position:absolute;inset:0}.final-cta-photo img{width:100%;height:100%;object-fit:cover}.final-cta-shade{background:linear-gradient(90deg,rgba(8,28,19,.86),rgba(8,28,19,.4),rgba(8,28,19,.45))}.final-cta-content{position:relative;z-index:2}.final-cta h2{font-size:clamp(58px,8vw,105px);margin:12px 0 30px}.final-cta-content p{font-size:10px;color:rgba(255,255,255,.6);margin-top:17px}.footer{background:#0b2418;color:#fff;padding:65px 0 25px}.footer-grid{display:grid;grid-template-columns:1.4fr .8fr .8fr 1fr;gap:50px}.footer p,.footer a,.footer span{font-size:11px;color:rgba(255,255,255,.48)}.footer strong{display:block;font-size:11px;margin-bottom:15px}.footer-grid>div:not(:first-child){display:flex;flex-direction:column;gap:8px}.footer-brand{margin-bottom:18px}.footer-bottom{border-top:1px solid rgba(255,255,255,.1);margin-top:50px;padding-top:20px;display:flex;justify-content:space-between;gap:20px}.whatsapp-float{position:fixed;right:22px;bottom:22px;z-index:1200;width:56px;height:56px;border-radius:50%;display:grid;place-items:center;background:#25d366;color:#fff;box-shadow:0 12px 30px rgba(37,211,102,.3);font-weight:800}.whatsapp-float span{position:absolute;right:66px;background:var(--green);padding:8px 10px;border-radius:8px;font-size:10px;opacity:0;transition:.2s;pointer-events:none}.whatsapp-float:hover span{opacity:1}.mobile-book{display:none}.modal{position:fixed;inset:0;z-index:2500;display:none;align-items:center;justify-content:center;padding:24px}.modal.open{display:flex}.modal-backdrop{position:absolute;inset:0;background:rgba(3,15,10,.8);backdrop-filter:blur(12px)}.modal-card{position:relative;z-index:2;width:min(1120px,100%);max-height:92vh;overflow:auto;display:grid;grid-template-columns:1fr 1fr;background:#fff;border-radius:28px;box-shadow:0 40px 120px rgba(0,0,0,.4)}.modal-close{position:absolute;z-index:5;right:14px;top:14px;width:40px;height:40px;border:0;border-radius:50%;background:rgba(0,0,0,.55);color:#fff;font-size:25px}.modal-gallery{position:relative;min-height:620px;background:#10241a}.modal-gallery>img{width:100%;height:100%;min-height:620px;object-fit:cover}.modal-arrow{position:absolute;top:50%;transform:translateY(-50%);width:44px;height:44px;border:0;border-radius:50%;background:rgba(255,255,255,.92);color:var(--green);font-size:28px}.modal-arrow.prev{left:15px}.modal-arrow.next{right:15px}.modal-thumbs{position:absolute;left:15px;right:15px;bottom:15px;display:flex;gap:7px;overflow:auto}.modal-thumb{width:58px;height:45px;flex:0 0 auto;padding:0;border:2px solid transparent;border-radius:7px;overflow:hidden;background:none;opacity:.65}.modal-thumb.active{border-color:#fff;opacity:1}.modal-thumb img{width:100%;height:100%;object-fit:cover}.modal-content{padding:50px 43px;overflow:auto}.modal-content h2{font-size:clamp(34px,4vw,51px);margin:10px 0 18px}.modal-content>p{font-size:13px;color:var(--muted);line-height:1.8}.modal-content .tour-meta{display:flex;gap:12px;flex-wrap:wrap;font-size:10px;color:var(--green);font-weight:800}.modal-columns{display:grid;grid-template-columns:1fr 1fr;gap:28px;margin:30px 0}.modal-columns h4{font-size:9px;letter-spacing:1.5px;text-transform:uppercase}.itinerary p,.modal-columns li{font-size:11px;color:var(--muted);margin:0 0 7px}.modal-columns ul{padding-left:17px}.not-title{margin-top:22px}.reveal{opacity:0;transform:translateY(20px);transition:opacity .75s ease,transform .75s ease}.reveal.visible{opacity:1;transform:none}@media(max-width:1000px){.hero-inner{grid-template-columns:1fr .55fr;gap:35px}.hero-card{transform:none}.tour-grid{grid-template-columns:repeat(2,1fr)}.feature-showcase{grid-template-columns:1fr}.feature-visual{min-height:500px}.feature-info{min-height:520px}.why-grid{grid-template-columns:repeat(2,1fr)}.value-card:nth-child(2){border-right:0}.value-card:nth-child(1),.value-card:nth-child(2){border-bottom:1px solid var(--line)}.about-panel{gap:45px}.footer-grid{grid-template-columns:1fr 1fr}.video-layout{grid-template-columns:1fr;gap:40px}}@media(max-width:760px){.container{width:min(100% - 28px,1180px)}.site-header{background:rgba(10,32,23,.82)}.nav{height:72px}.menu-toggle{display:block}.nav-links{display:none;position:absolute;left:14px;right:14px;top:66px;background:#0d2a1d;border:1px solid rgba(255,255,255,.1);border-radius:18px;padding:10px;flex-direction:column;align-items:stretch;gap:0;box-shadow:0 25px 50px rgba(0,0,0,.3)}.nav-links.open{display:flex}.nav-links>a:not(.nav-book){padding:13px}.nav-book{margin-top:5px;justify-content:center}.hero{min-height:800px;height:auto}.hero-inner{display:flex;flex-direction:column;align-items:stretch;justify-content:center;padding-top:125px;padding-bottom:90px;gap:40px}.hero-copy{max-width:none}.hero h1{font-size:clamp(49px,14vw,72px)}.hero-copy>p{font-size:14px}.hero-actions{flex-direction:column}.hero-actions .btn{width:100%}.hero-trust{flex-direction:column;gap:8px;margin-top:25px}.hero-card{align-self:stretch;max-width:none;margin:0;transform:none}.hero-card-image{height:165px}.hero-bottom{display:none}.section{padding:80px 0}.intro-layout,.section-top,.faq-layout,.about-panel{grid-template-columns:1fr;gap:25px}.section-number{display:none}.intro-copy{padding-top:0}.pillars{grid-template-columns:1fr 1fr;margin-top:50px}.pillars>div{border-bottom:1px solid var(--line);border-right:1px solid var(--line)}.pillars>div:nth-child(2),.pillars>div:nth-child(4){border-right:0}.pillars>div:nth-child(3),.pillars>div:nth-child(4){border-bottom:0}.section-top{gap:18px;margin-bottom:35px}.section-top h2,.intro-head h2{font-size:45px}.feature-visual{min-height:390px}.feature-info{padding:37px 25px;min-height:0}.feature-info h3{font-size:36px}.feature-checks{grid-template-columns:1fr}.feature-bottom{flex-direction:column;align-items:stretch}.feature-bottom .btn{width:100%}.tour-grid{grid-template-columns:1fr}.tour-card-media{height:240px}.filter-wrap{justify-content:flex-start;overflow:auto}.filters{flex-wrap:nowrap;min-width:max-content}.masonry{grid-template-columns:1fr 1fr;grid-auto-rows:145px}.gallery-1{grid-column:span 2;grid-row:span 3}.gallery-2,.gallery-3,.gallery-4,.gallery-5,.gallery-6,.gallery-7,.gallery-9,.gallery-10{grid-column:span 1;grid-row:span 2}.gallery-8{grid-column:span 2;grid-row:span 2}.video-grid{grid-template-columns:1fr}.video-card video{height:350px}.why-grid{grid-template-columns:1fr}.value-card{border-right:0!important;border-bottom:1px solid var(--line)!important;min-height:240px}.value-card:last-child{border-bottom:0!important}.about-image{height:370px}.final-cta{height:600px;min-height:600px}.final-cta h2{font-size:62px}.footer-grid{grid-template-columns:1fr 1fr;gap:30px}.footer-bottom{flex-direction:column}.whatsapp-float{display:none}.mobile-book{position:fixed;z-index:1300;left:10px;right:10px;bottom:10px;display:flex;align-items:center;justify-content:space-between;gap:12px;padding:10px 10px 10px 15px;background:rgba(11,36,24,.96);color:#fff;border-radius:17px;box-shadow:0 18px 40px rgba(0,0,0,.25);backdrop-filter:blur(15px)}.mobile-book span{display:flex;flex-direction:column}.mobile-book b{font-size:11px}.mobile-book small{font-size:8px;color:rgba(255,255,255,.55);margin-top:2px}.mobile-book a{background:var(--accent);color:var(--green);padding:11px 14px;border-radius:12px;font-size:10px;font-weight:800}.modal{padding:8px}.modal-card{grid-template-columns:1fr;max-height:95vh}.modal-gallery,.modal-gallery>img{min-height:310px;height:310px}.modal-content{padding:32px 22px}.modal-columns{grid-template-columns:1fr}.modal-content .btn{width:100%}}@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}.reveal,.tour-card,.value-card{transition:none!important;opacity:1!important;transform:none!important}.tour-card:hover,.hero-card{transform:none}}
