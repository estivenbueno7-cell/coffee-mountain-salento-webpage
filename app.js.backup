function optimizedPath(path) {
  const file = path.split('/').pop();
  const dot = file.lastIndexOf('.');
  return `images/optimized/${dot > 0 ? file.slice(0, dot) : file}.webp`;
}
function cleanImages(tour) {
  return [...new Set((tour.images || []).map(optimizedPath))].filter(Boolean);
}
function whatsappLink(tour, suffix='') {
  const text = `Hola Salento Tours Mountain 👋. Quiero ${suffix || 'información'} sobre: ${tour.title}.`;
  return `https://wa.me/${WHATSAPP}?text=${encodeURIComponent(text)}`;
}
function escapeHtml(value='') {
  return String(value).replace(/[&<>"']/g, m => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[m]));
}
function getMeta(id){ return TOUR_META[id] || {category:'tour',label:'Experiencia',price:'Consultar',duration:'Consultar',icon:'✦'}; }

const tourGrid = document.getElementById('tourGrid');
const modal = document.getElementById('tourModal');
let activeTour = null;
let activeImage = 0;

function renderTours(filter='all') {
  const entries = Object.entries(tours).filter(([id]) => {
    const category = getMeta(id).category;
    return filter === 'all' || category === filter || (filter === 'cafe' && category === 'estrella');
  });
  tourGrid.innerHTML = entries.map(([id,tour]) => {
    const meta=getMeta(id), images=cleanImages(tour), image=images[0] || FALLBACK_IMAGE;
    const isFeatured=meta.featured;
    return `<article class="tour-card ${isFeatured?'tour-card--featured':''}">
      <button class="tour-card-media" data-tour="${id}" aria-label="Ver ${escapeHtml(tour.title)}">
        <img src="${image}" alt="${escapeHtml(tour.title)}" loading="lazy" decoding="async">
        <span class="tour-card-badge">${meta.icon} ${escapeHtml(isFeatured?'EXPERIENCIA PRINCIPAL':meta.label)}</span>
        <span class="tour-card-arrow">↗</span>
      </button>
      <div class="tour-card-content">
        <div class="tour-card-meta"><span>${escapeHtml(meta.duration)}</span><span>Salento · Quindío</span></div>
        <h3>${escapeHtml(tour.title)}</h3>
        <p>${escapeHtml(tour.description.slice(0,155))}${tour.description.length>155?'…':''}</p>
        <div class="tour-card-bottom"><div><small>${meta.price==='Consultar'?'CONSULTA':'DESDE'}</small><strong>${escapeHtml(meta.price)}</strong></div><button class="tour-detail" data-tour="${id}">Ver experiencia <span>→</span></button></div>
      </div>
    </article>`;
  }).join('');
  observeReveals();
}

function renderFeatured() {
  const tour=tours.salento00, images=cleanImages(tour).slice(0,5);
  const main=document.getElementById('featuredImage');
  const thumbs=document.getElementById('featuredThumbs');
  main.src=images[0] || FALLBACK_IMAGE;
  thumbs.innerHTML=images.map((src,i)=>`<button class="featured-thumb ${i===0?'active':''}" data-index="${i}" aria-label="Foto ${i+1}"><img src="${src}" alt="" loading="lazy"></button>`).join('');
  thumbs.querySelectorAll('button').forEach(btn=>btn.addEventListener('click',()=>{
    thumbs.querySelectorAll('button').forEach(b=>b.classList.remove('active'));
    btn.classList.add('active'); main.src=images[Number(btn.dataset.index)];
  }));
}

function openTour(id){
  const tour=tours[id]; if(!tour)return;
  activeTour=id; activeImage=0;
  const meta=getMeta(id), images=cleanImages(tour);
  const image=document.getElementById('modalImage'); image.src=images[0]||FALLBACK_IMAGE; image.alt=tour.title;
  document.getElementById('modalTitle').textContent=tour.title;
  document.getElementById('modalCategory').textContent=meta.label;
  document.getElementById('modalDescription').textContent=tour.description;
  document.getElementById('modalMeta').innerHTML=`<span>⏱ ${escapeHtml(meta.duration)}</span><span>📍 Salento</span><span>💰 ${escapeHtml(meta.price)}</span>`;
  document.getElementById('modalItinerary').innerHTML=formatLines(tour.itinerary);
  fillList('modalIncludes',tour.includes); fillList('modalNotIncludes',tour.notIncludes);
  document.getElementById('modalWhatsapp').href=whatsappLink(tour,'reservar');
  document.getElementById('modalThumbs').innerHTML=images.map((src,i)=>`<button class="modal-thumb ${i===0?'active':''}" data-index="${i}"><img src="${src}" alt="Foto ${i+1}" loading="lazy"></button>`).join('');
  document.querySelectorAll('.modal-thumb').forEach(b=>b.addEventListener('click',()=>setModalImage(Number(b.dataset.index))));
  modal.classList.add('open'); modal.setAttribute('aria-hidden','false'); document.body.classList.add('modal-open');
}
function setModalImage(index){
  if(!activeTour)return; const images=cleanImages(tours[activeTour]); if(!images.length)return;
  activeImage=(index+images.length)%images.length;
  const img=document.getElementById('modalImage'); img.src=images[activeImage];
  document.querySelectorAll('.modal-thumb').forEach((b,i)=>b.classList.toggle('active',i===activeImage));
}
function closeModal(){ modal.classList.remove('open'); modal.setAttribute('aria-hidden','true'); document.body.classList.remove('modal-open'); }
function fillList(id,items=[]){ document.getElementById(id).innerHTML=items.map(item=>`<li>${escapeHtml(item)}</li>`).join(''); }
function formatLines(text=''){ return text.split('\n').filter(Boolean).map(line=>`<p>${escapeHtml(line.replace(/^\s*[—-]\s*/,''))}</p>`).join(''); }

function renderSiteGallery(){
  document.getElementById('siteGallery').innerHTML=galleryItems.map(([src,alt],i)=>`<button class="gallery-item gallery-${i+1}" data-gallery="${i}" aria-label="Ampliar ${escapeHtml(alt)}"><img src="${src}" alt="${escapeHtml(alt)}" loading="lazy" decoding="async"><span>${escapeHtml(alt)} <b>↗</b></span></button>`).join('');
  document.querySelectorAll('[data-gallery]').forEach(btn=>btn.addEventListener('click',()=>openGallery(Number(btn.dataset.gallery))));
}
function openGallery(index){
  const [src,alt]=galleryItems[index]; activeTour=null; activeImage=0;
  document.getElementById('modalImage').src=src; document.getElementById('modalImage').alt=alt;
  document.getElementById('modalTitle').textContent=alt; document.getElementById('modalCategory').textContent='Galería';
  document.getElementById('modalDescription').textContent='Una imagen de nuestras experiencias en el Quindío.';
  document.getElementById('modalMeta').innerHTML='<span>📸 Salento Tours Mountain</span>';
  document.getElementById('modalItinerary').innerHTML=''; document.getElementById('modalIncludes').innerHTML=''; document.getElementById('modalNotIncludes').innerHTML='';
  document.querySelector('.modal-columns').style.display='none'; document.getElementById('modalWhatsapp').style.display='none';
  document.getElementById('modalThumbs').innerHTML=''; modal.classList.add('open'); modal.setAttribute('aria-hidden','false'); document.body.classList.add('modal-open');
}
function restoreModal(){ document.querySelector('.modal-columns').style.display=''; document.getElementById('modalWhatsapp').style.display='inline-flex'; }
function renderVideos(){
  const target=document.getElementById('videoGrid');
  if(!VIDEO_ITEMS.length){ target.innerHTML=`<div class="video-empty"><div class="video-play">▶</div><strong>Tu experiencia, en movimiento.</strong><p>Agrega tus videos en <code>videos/</code> y aparecerán aquí como una galería inmersiva.</p></div>`; return; }
  target.innerHTML=VIDEO_ITEMS.map(v=>`<article class="video-card"><video controls preload="metadata" poster="${v.poster||''}"><source src="${v.src}" type="video/mp4"></video><h3>${escapeHtml(v.title)}</h3></article>`).join('');
}

const menuToggle=document.getElementById('menuToggle'), navLinks=document.getElementById('navLinks');
menuToggle.addEventListener('click',()=>{const open=navLinks.classList.toggle('open');menuToggle.setAttribute('aria-expanded',String(open));});
navLinks.querySelectorAll('a').forEach(a=>a.addEventListener('click',()=>navLinks.classList.remove('open')));

document.addEventListener('click',e=>{
  const btn=e.target.closest('[data-tour]');
  if(btn){restoreModal();openTour(btn.dataset.tour);}
  if(e.target.closest('[data-close]'))closeModal();
});
document.getElementById('prevImage').addEventListener('click',()=>setModalImage(activeImage-1));
document.getElementById('nextImage').addEventListener('click',()=>setModalImage(activeImage+1));
document.addEventListener('keydown',e=>{if(e.key==='Escape')closeModal();if(modal.classList.contains('open')&&e.key==='ArrowRight')setModalImage(activeImage+1);if(modal.classList.contains('open')&&e.key==='ArrowLeft')setModalImage(activeImage-1);});

document.querySelectorAll('.filter').forEach(btn=>btn.addEventListener('click',()=>{document.querySelectorAll('.filter').forEach(b=>b.classList.remove('active'));btn.classList.add('active');renderTours(btn.dataset.filter);}));

const revealObserver=new IntersectionObserver(entries=>entries.forEach(entry=>{if(entry.isIntersecting){entry.target.classList.add('visible');revealObserver.unobserve(entry.target);}}),{threshold:.08});
function observeReveals(){document.querySelectorAll('.reveal:not(.visible),.tour-card:not(.visible),.value-card:not(.visible)').forEach(el=>revealObserver.observe(el));}

const header=document.getElementById('header');
window.addEventListener('scroll',()=>header.classList.toggle('scrolled',window.scrollY>30),{passive:true});

document.getElementById('year').textContent=new Date().getFullYear();
renderTours(); renderFeatured(); renderSiteGallery(); renderVideos(); observeReveals();
